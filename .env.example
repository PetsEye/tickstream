# Copy to .env and adjust as needed. All TICKSTREAM_* vars override config/config.yaml.

TICKSTREAM_CONFIG_FILE=config/config.yaml
TICKSTREAM_APP__LOG_LEVEL=INFO
TICKSTREAM_PRODUCER__SOURCE=coinbase

# Postgres / TimescaleDB (consumed by docker-compose and the API)
POSTGRES_USER=tickstream
POSTGRES_PASSWORD=tickstream
POSTGRES_DB=tickstream

# Host port mappings (change if these clash with services you already run)
KAFKA_HOST_PORT=29092
TIMESCALE_HOST_PORT=55432
GRAFANA_HOST_PORT=3000
API_HOST_PORT=8000
WEB_HOST_PORT=8080

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tickstream

# Spark streaming tuning (see docs/benchmarks.md)
SPARK_TRIGGER_INTERVAL=5 seconds
MAX_OFFSETS_PER_TRIGGER=5000
